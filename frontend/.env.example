# Copia este archivo a .env.production y ajusta la URL.
# En desarrollo NO hace falta: Vite redirige /api a http://localhost:5000 (vite.config.js).
# En producción, VITE_API_URL se incrusta al ejecutar `npm run build`.
# Pon la URL pública del backend, sin barra final.
VITE_API_URL=https://tu-backend.example.com
