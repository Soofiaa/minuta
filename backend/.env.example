# Copia este archivo como .env y completa lo que uses.
# Nunca subas el .env real al repo (está en .gitignore).

# Proveedor de transcripción de audio: groq | openai | local
TRANSCRIPTION_PROVIDER=groq

# Groq: clave gratuita en https://console.groq.com/keys
# (plan gratuito, sin tarjeta: Whisper large-v3-turbo, 25 MB por archivo)
GROQ_API_KEY=

# OpenAI: solo si TRANSCRIPTION_PROVIDER=openai (de pago)
OPENAI_API_KEY=

# Ruta de la base de datos SQLite
DATABASE_PATH=minuta.db

# Puerto del backend
PORT=5000
